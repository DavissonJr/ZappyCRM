# Copie para .env e preencha antes de rodar docker compose
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
EVOLUTION_API_KEY=troque-por-uma-chave-forte

# SMTP — usado pra mandar o código de confirmação por e-mail no cadastro.
# Exemplo com Gmail: gere uma "Senha de app" em myaccount.google.com/apppasswords
# (a senha normal da sua conta Google NÃO funciona aqui se tiver 2FA ativado).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app-aqui
SMTP_FROM_EMAIL=seu-email@gmail.com

# Mercado Pago — usado pra cobrar a assinatura mensal dos seus clientes.
# Pega o Access Token de PRODUÇÃO em: https://www.mercadopago.com.br/developers/panel/app
# (use o token de TESTE enquanto estiver validando o fluxo, antes de ir pra produção)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxx

# URL pública (sem barra no final) onde SUA API está acessível de fora —
# o Mercado Pago manda a notificação de pagamento pra cá. Localmente, use
# a URL que o ngrok te dá (ex: https://abc123.ngrok-free.app). Em produção,
# use o domínio de verdade da sua API.
MERCADOPAGO_WEBHOOK_BASE_URL=https://abc123.ngrok-free.app

# URL pública que o Mercado Pago usa pra te redirecionar de volta depois do
# pagamento (precisa ser HTTPS, não pode ser localhost). Localmente, pode
# usar a mesma URL do ngrok acima (o redirecionamento não vai funcionar
# perfeitamente, mas não impede o pagamento de ser confirmado — quem confirma
# de verdade é o webhook, não esse redirecionamento).
APP_PUBLIC_URL=https://abc123.ngrok-free.app
